# Copy to infra/.env (git-ignored) and replace the placeholders.
# Never commit real values.

POSTGRES_DB=duello
POSTGRES_USER=duello
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Used by the backend once it exists (compose profile "backend").
MEDIA_BASE_URL=http://localhost:8080/media
# Path inside the backend container to a Firebase Admin service-account JSON
# (mount it from a git-ignored location; never put the JSON in the repo).
FIREBASE_SERVICE_ACCOUNT_FILE=
