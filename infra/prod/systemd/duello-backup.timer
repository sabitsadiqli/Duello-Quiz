# Runs duello-backup.service daily at 23:30 UTC (03:30 in Baku, quiet hours).
# Persistent=true: a run missed while the VM was off happens at the next boot.
[Unit]
Description=Daily Duello Quiz backup

[Timer]
OnCalendar=*-*-* 23:30:00 UTC
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
