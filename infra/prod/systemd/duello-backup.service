# Daily Duello Quiz backup (PostgreSQL dump + media tarball, optional off-VM copy).
# Installed by scripts/bootstrap-vm.sh, which replaces @DEPLOY_USER@ and @DUELLO_DIR@.
# Logs: journalctl -u duello-backup.service
[Unit]
Description=Duello Quiz backup (pg_dump + media)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=@DEPLOY_USER@
Group=@DEPLOY_USER@
# Optional settings for scripts/backup.sh (BACKUP_RCLONE_REMOTE, RETENTION_DAYS).
EnvironmentFile=-@DUELLO_DIR@/backup.env
ExecStart=@DUELLO_DIR@/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
