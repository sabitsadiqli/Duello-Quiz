# Settings for scripts/backup.sh (off-VM copy to Cloudflare R2, OQ-103).
# Copy to /opt/duello/backup.env (owner deploy, chmod 600) and fill in the keys.
# Read by duello-backup.service (EnvironmentFile) and by backup.sh when run by hand.
# Never commit real values. Keep a copy in the password manager: without these keys
# the off-VM backups cannot be downloaded after losing the VM.

RETENTION_DAYS=14

# rclone remote "r2" defined through environment variables (no rclone.conf needed).
# Cloudflare dashboard → R2 → bucket "duello-backups" (private) → Manage API tokens →
# "Object Read & Write", limited to this bucket. Endpoint: R2 → bucket → Settings →
# S3 API, without the bucket name. EU-jurisdiction bucket (recommended):
# https://<account-id>.eu.r2.cloudflarestorage.com, otherwise without ".eu".
BACKUP_RCLONE_REMOTE=r2:duello-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=change-me
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=change-me
RCLONE_CONFIG_R2_REGION=auto
RCLONE_CONFIG_R2_ACL=private
# Bucket-scoped tokens cannot list/create buckets; skip that check.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
