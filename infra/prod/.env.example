# Runtime configuration of the Duello Quiz stack on the VM.
# Copy to /opt/duello/.env (git-ignored, chmod 600) and replace every placeholder.
# Never commit real values. Keep a copy of the passwords in your password manager.

# --- Public address ---------------------------------------------------------------
# Host name of this server (ADR 0001): api-dev.duelloquiz.app (dev) or
# api.duelloquiz.app (prod). Its Cloudflare DNS record must be "DNS only" and point
# to this VM. Caddy requests the TLS certificate for exactly this name.
DUELLO_DOMAIN=api-dev.duelloquiz.app
# Let's Encrypt account contact (a project address, never a personal one). Let's
# Encrypt no longer sends expiry mails; the uptime check on /health covers that.
ACME_EMAIL=support@duelloquiz.app
# Public base URL of the images, served by Caddy: https://<DUELLO_DOMAIN>/media
MEDIA_BASE_URL=https://api-dev.duelloquiz.app/media

# --- Backend image ------------------------------------------------------------------
# Set by scripts/deploy.sh on every deploy (commit SHA on dev, version on prod).
BACKEND_TAG=main
# Memory limit of the backend container; the JVM heap is 75 % of it.
# 2g fits a 4 GB CAX11/CX22 next to PostgreSQL and Caddy.
BACKEND_MEMORY_LIMIT=2g

# --- PostgreSQL ---------------------------------------------------------------------
POSTGRES_DB=duello
POSTGRES_USER=duello
# Long random value, e.g. `openssl rand -base64 32 | tr -d '/+='`.
# Only read when the database is created the first time; changing it later needs
# ALTER USER inside PostgreSQL as well.
POSTGRES_PASSWORD=change-me

# --- Secret files -------------------------------------------------------------------
# Host directory mounted read-only into the backend at /run/secrets/duello.
# Owned by UID 10001 (the backend user), mode 0700; files mode 0400.
SECRETS_DIR=/opt/duello/secrets
# Firebase Admin service-account JSON, as seen INSIDE the container.
# Empty = backend starts, but every /v1 call returns 401. Once the file is in place:
# FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/duello/firebase-admin.json
FIREBASE_SERVICE_ACCOUNT_FILE=
# Optional; taken from the service account when empty.
FIREBASE_PROJECT_ID=
# Optional private display-name blocklist (OQ-030) from the private content repo,
# one term per line, e.g. /run/secrets/duello/display-name-blocklist.txt
DISPLAY_NAME_BLOCKLIST_FILE=

# --- Misc ---------------------------------------------------------------------------
LOG_LEVEL=INFO
