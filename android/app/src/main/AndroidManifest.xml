<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OQ-D25 / OQ-100: no ads, so no Advertising ID. firebase-analytics (play-services-measurement)
         merges this permission in by default; remove it from the merged manifest. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- Same for the Privacy Sandbox ad permissions of play-services-measurement-api. -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application
        android:name=".DuelloApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DuelloQuiz">
        <!-- OQ-100: Analytics never collects the Advertising ID or ad personalization signals. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <!-- OQ-101: Crashlytics reports only from release builds (placeholder per build type in
             app/build.gradle.kts). -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsCollectionEnabled}" />
        <!-- uiMode is handled in place (Compose recomposes); the app night mode is set through
             UiModeManager on Android 12+ so the splash uses the chosen theme (SET-01).
             singleTop: tapping a reminder while the app is open delivers onNewIntent instead of
             recreating the activity, so a running duel stays on screen (NOTIF-05). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DuelloQuiz.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
