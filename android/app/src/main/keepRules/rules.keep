# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Type-safe navigation routes are @Serializable classes in *.navigation packages; navigation
# looks up their serializers by type. kotlinx.serialization ships rules for the generated
# serializers; this keeps the route classes themselves stable.
-keep @kotlinx.serialization.Serializable class com.sabit.duelloquiz.**.navigation.** { *; }
