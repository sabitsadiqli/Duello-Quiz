    "stateLayer": {
      "hoverOpacity": 0.08,
      "focusOpacity": 0.10,
      "pressedOpacity": 0.10,
      "draggedOpacity": 0.16,
      "disabledContentOpacity": 0.38,
      "disabledContainerOpacity": 0.12,
      "notes": "Disabled content = onSurface at 0.38, disabled container = onSurface at 0.12 (M3 standard). Disabled text is exempt from WCAG contrast; never use disabled styling for information the user must read."
    }
  },

  "typography": {
    "fontFamily": {
      "brand": {
        "name": "Inter",
        "source": "Google Fonts, SIL Open Font License 1.1",
        "weights": [400, 500, 600, 700],
        "delivery": "Bundle the static TTF files in res/font (inter_regular, inter_medium, inter_semibold, inter_bold). Do not use downloadable fonts: the first frame and offline start must already use the final font.",
        "coverage": "Full Azerbaijani Latin: Ə ə Ğ ğ I ı İ i Ö ö Ü ü Ç ç Ş ş. Verify with the test string in design/README.md.",
        "features": "Use tabular figures (fontFeatureSettings \"tnum\") for the timer, progress \"3 / 10\", score and rating so digits do not jitter."
      },
      "fallback": {
        "name": "sans-serif (system: Roboto / Noto Sans)",
        "notes": "Android resolves sans-serif to Roboto with Noto fallback; both cover Azerbaijani Latin."
      }
    },
    "scale": {
      "displayLarge":   { "fontSize": 57, "lineHeight": 64, "fontWeight": 700, "letterSpacing": -0.25 },
      "displayMedium":  { "fontSize": 45, "lineHeight": 52, "fontWeight": 700, "letterSpacing": 0 },
      "displaySmall":   { "fontSize": 36, "lineHeight": 44, "fontWeight": 700, "letterSpacing": 0 },
      "headlineLarge":  { "fontSize": 32, "lineHeight": 40, "fontWeight": 600, "letterSpacing": 0 },
      "headlineMedium": { "fontSize": 28, "lineHeight": 36, "fontWeight": 600, "letterSpacing": 0 },
      "headlineSmall":  { "fontSize": 24, "lineHeight": 32, "fontWeight": 600, "letterSpacing": 0 },
      "titleLarge":     { "fontSize": 22, "lineHeight": 28, "fontWeight": 600, "letterSpacing": 0 },
      "titleMedium":    { "fontSize": 16, "lineHeight": 24, "fontWeight": 600, "letterSpacing": 0.15 },
      "titleSmall":     { "fontSize": 14, "lineHeight": 20, "fontWeight": 600, "letterSpacing": 0.1 },
      "bodyLarge":      { "fontSize": 16, "lineHeight": 24, "fontWeight": 400, "letterSpacing": 0.15 },
      "bodyMedium":     { "fontSize": 14, "lineHeight": 20, "fontWeight": 400, "letterSpacing": 0.25 },
      "bodySmall":      { "fontSize": 12, "lineHeight": 16, "fontWeight": 400, "letterSpacing": 0.4 },
      "labelLarge":     { "fontSize": 14, "lineHeight": 20, "fontWeight": 600, "letterSpacing": 0.1 },
      "labelMedium":    { "fontSize": 12, "lineHeight": 16, "fontWeight": 500, "letterSpacing": 0.5 },
      "labelSmall":     { "fontSize": 11, "lineHeight": 16, "fontWeight": 500, "letterSpacing": 0.5 }
    },
    "notes": [
      "Names match androidx.compose.material3.Typography parameters.",
      "Sizes are sp so they follow the user's font scale. Every screen must work at font scale 1.3 without truncation and stay usable (scrolling allowed) at 2.0.",
      "Question text uses titleLarge, options use bodyLarge (titleMedium weight 600 is NOT used for options to keep long Azerbaijani words narrow)."
    ]
  },

  "spacing": {
    "none": 0,
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48,
    "huge": 64,
    "layout": {
      "screenGutter": 16,
      "screenGutterWide": 24,
      "wideBreakpoint": 600,
      "maxContentWidth": 560,
      "sectionGap": 24,
      "listItemGap": 12,
      "notes": "screenGutter applies below 600dp width; screenGutterWide and centred maxContentWidth at 600dp and above (tablets, landscape)."
    }
  },

  "size": {
    "minTouchTarget": 48,
    "buttonHeight": 48,
    "buttonHeightLarge": 56,
    "textFieldHeight": 56,
    "iconSmall": 18,
    "icon": 24,
    "iconLarge": 32,
    "avatar": 40,
    "avatarLarge": 56,
    "topAppBarHeight": 64,
    "optionCardMinHeight": 56,
    "categoryTileMinHeight": 112,
    "categoryIconContainer": 48,
    "timerRing": 48,
    "timerStroke": 4,
    "progressBarHeight": 4,
    "questionImageAspect": "16:9",
    "questionImageMaxHeight": 200,
    "reviewThumbnail": 64,
    "confidenceChip": 88,
    "bannerMinHeight": 56,
    "splashLogo": 96,
    "avatarXLarge": 80,
    "duelBadge": 32,
    "duelPlayerPanelMinHeight": 104,
    "phaseSegmentHeight": 4,
    "searchPulse": 176,
    "calibrationBarHeight": 8,
    "notes": {
      "confidenceChip": "Minimum height of an Əminlik chip (duel). Width is one third of the content width minus two space.md gaps (~101dp on a 360dp phone); the chip grows in height at large font scales. Not a fixed square.",
      "avatarXLarge": "Profile header and match intro.",
      "duelBadge": "Mini Əminlik badge and answer-letter badge in the duel player panel, calibration rows and reveal.",
      "duelPlayerPanelMinHeight": "Pinned self/opponent panels in the match header; grows with font scale and in the result phase.",
      "searchPulse": "Outer diameter of the decorative search pulse rings around the own avatar on the duel search screen."
    }
  },

  "shape": {
    "none": 0,
    "extraSmall": 4,
    "small": 8,
    "medium": 12,
    "large": 16,
    "extraLarge": 28,
    "full": "50%",
    "component": {
      "button": "full",
      "textField": "extraSmall",
      "optionCard": "medium",
      "categoryTile": "large",
      "card": "medium",
      "banner": "medium",
      "dialog": "extraLarge",
      "bottomSheet": "extraLarge (top corners only)",
      "snackbar": "extraSmall",
      "chip": "small",
      "confidenceChip": "large",
      "questionImage": "medium",
      "avatar": "full",
      "duelPlayerPanel": "large",
      "duelBadge": "small",
      "confidencePanel": "extraLarge (top corners only)",
      "calibrationCard": "large",
      "statusPill": "full"
    },
    "notes": "Names match androidx.compose.material3.Shapes (extraSmall..extraLarge) using RoundedCornerShape(dp)."
  },

  "elevation": {
    "level0": 0,
    "level1": 1,
    "level2": 3,
    "level3": 6,
    "level4": 8,
    "level5": 12,
    "component": {
      "topAppBar": "level0 (level2 when content is scrolled under it)",
      "card": "level0 — use surfaceContainer* colours instead of shadow",
      "optionCard": "level0",
      "categoryTile": "level0",
      "dialog": "level3",
      "snackbar": "level3",
      "bottomSheet": "level1",
      "fab": "level3",
      "duelOverlayCard": "level3 (self-reconnecting overlay card over a scrim)",
      "duelPlayerPanel": "level0",
      "confidencePanel": "level0 — surfaceContainerHigh carries the depth"
    },
    "notes": "Material 3 tonal elevation: depth is shown by surfaceContainer* roles, not shadows. Shadows only on dialog, snackbar, FAB."
  },

  "motion": {
    "duration": {
      "short1": 50,
      "short2": 100,
      "short3": 150,
      "short4": 200,
      "medium1": 250,
      "medium2": 300,
      "medium3": 350,
      "medium4": 400,
      "long1": 450,
      "long2": 500,
      "long3": 550,
      "long4": 600
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.0, 0.0, 1.0)",
      "standardDecelerate": "cubic-bezier(0.0, 0.0, 0.0, 1.0)",
      "standardAccelerate": "cubic-bezier(0.3, 0.0, 1.0, 1.0)",
      "emphasizedDecelerate": "cubic-bezier(0.05, 0.7, 0.1, 1.0)",
      "emphasizedAccelerate": "cubic-bezier(0.3, 0.0, 0.8, 0.15)",
      "linear": "linear"
    },
    "game": {
      "quizRevealHoldMs": 1500,
      "quizRevealHoldSource": "docs/mvp-spec.md §1 / OQ-023. Server deadline assumes 1500 ms; do not change without a spec change.",
      "timerWarningThresholdMs": 5000,
      "timerTick": "linear, driven by wall-clock (not by animation frames)",
      "timerWarningPulse": { "durationMs": 1000, "scaleFrom": 1.0, "scaleTo": 1.08, "easing": "standard", "repeat": "once per remaining second while <= 5 s" },
      "optionRevealColour": { "durationMs": 200, "easing": "standard" },
      "optionWrongShake": { "durationMs": 300, "amplitudeDp": 4, "cycles": 2 },
      "questionTransition": { "durationMs": 300, "type": "slide 1/8 width + fade", "enterEasing": "emphasizedDecelerate", "exitEasing": "emphasizedAccelerate" },
      "scoreCountUp": { "durationMs": 600, "easing": "emphasizedDecelerate" },
      "screenTransition": { "durationMs": 300, "type": "shared axis X (forward) / fade-through (top level)" }
    },
    "duel": {
      "notes": "Display-only timing for the duel UI. Phase lengths are server rules (docs/mvp-spec.md §2); the client always counts down to the server deadline and never ends or extends a phase on its own. Animations never delay sending a pick or an answer (DUEL-16).",
      "phaseNominalMs": { "intro": 3000, "question": 3000, "confidence": 5000, "answer": 10000, "result": 3000, "searchQueue": 30000, "reconnectWindow": 10000, "use": "Denominator for the timer ring fraction only: fraction = clamp(remaining / nominal, 0, 1)." },
      "timerWarningThresholdMs": { "question": 0, "confidence": 2000, "answer": 3000, "result": 0, "notes": "0 = no warning colour in that phase. Warning uses game.timerWarning and the existing timerWarningPulse." },
      "phaseTransition": { "durationMs": 300, "enterEasing": "emphasizedDecelerate", "exitEasing": "emphasizedAccelerate", "type": "body content cross-fade + 1/8 height slide up; the pinned header never moves" },
      "confidencePanelEnter": { "durationMs": 300, "easing": "emphasizedDecelerate", "type": "panel slides up from the bottom edge + fade" },
      "chipPress": { "durationMs": 100, "scaleTo": 0.96, "notes": "Visual press only. round.bet is sent on the tap, before or in parallel with this animation." },
      "chipLock": { "durationMs": 200, "scaleTo": 1.05, "easing": "emphasizedDecelerate", "othersFadeToAlpha": 0.38 },
      "statusPillChange": { "durationMs": 150, "type": "cross-fade" },
      "revealFlip": { "durationMs": 400, "firstHalfEasing": "emphasizedAccelerate", "secondHalfEasing": "emphasizedDecelerate", "rotation": "rotationY 0 -> 180 deg, content swaps at 90 deg", "cameraDistanceDp": 12, "notes": "Both player panels flip in the SAME frame. Never staggered (fairness)." },
      "revealOptionColour": { "delayMs": 0, "durationMs": 200, "easing": "standard" },
      "revealPointsPop": { "delayMs": 400, "durationMs": 200, "scaleFrom": 0.8, "scaleTo": 1.0, "easing": "emphasizedDecelerate" },
      "revealScoreCountUp": { "delayMs": 600, "durationMs": 600, "easing": "emphasizedDecelerate" },
      "revealMinRemainingMs": 1500,
      "revealMinRemainingNotes": "If round.result arrives with less than this left in the result phase (late message, rejoin), skip flip and count-up and show the final state with a 150 ms cross-fade.",
      "searchPulse": { "durationMs": 2000, "rings": 2, "ringOffsetMs": 1000, "scaleFrom": 0.55, "scaleTo": 1.0, "alphaFrom": 0.24, "alphaTo": 0.0, "easing": "standardDecelerate", "repeat": "infinite while searching" },
      "introEnter": { "durationMs": 400, "easing": "emphasizedDecelerate", "type": "self row slides in from the start edge, opponent row from the end edge, 1/4 width + fade, same start time" },
      "resultHeroPop": { "durationMs": 300, "scaleFrom": 0.9, "scaleTo": 1.0, "easing": "emphasizedDecelerate" },
      "opponentReturnedHoldMs": 2000,
      "reducedMotion": "No pulse, slide, flip, pop or count-up: content cross-fades in 150 ms and numbers show their final value. Colours, timer ring and all game timing are unchanged."
    },
    "reducedMotion": "When the system setting 'Remove animations' (ANIMATOR_DURATION_SCALE = 0) is on: no shake, no pulse, no slide, no count-up; colour changes and the timer bar still update. Timing of the game (1500 ms reveal) is unchanged."
  }
}
