{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sabitsadiqli/Duello-Quiz/content/schema/exam.schema.json",
  "title": "Duello Quiz mock exam variant (variant.json)",
  "description": "One sınaq variant: exams/<template>/<variant-id>/variant.json in the bank. Structure checks against the DİM template (task counts per section, groups, option count), reviewer rules and audio checks are done by the importer (docs/adr/0002-mock-exams-data-and-audio.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "template", "number", "language", "status", "author", "groups", "tasks"],
  "$defs": {
    "i18n": {
      "type": "object",
      "required": ["az"],
      "properties": { "az": { "type": "string", "minLength": 1 } },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "licence": { "type": "string", "enum": ["original", "public-domain", "CC0-1.0", "CC-BY-4.0", "CC-BY-3.0"] },
    "mark": { "type": "string", "enum": ["0", "1/3", "1/2", "2/3", "1"] },
    "person": { "type": "string", "minLength": 1, "maxLength": 64 },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name", "voice"],
      "properties": {
        "role": { "type": "string", "pattern": "^[A-Z]$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "voice": { "type": "string", "enum": ["en_GB-alba-medium", "en_GB-cori-high", "en_US-libritts_r-medium"] },
        "speakerId": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "voice": { "const": "en_US-libritts_r-medium" } } },
          "then": { "required": ["speakerId"], "properties": { "speakerId": { "const": 452 } } },
          "else": { "not": { "required": ["speakerId"] } }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "section", "licence", "author"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "type": "string", "enum": ["reading", "listening"] },
        "section": { "$ref": "#/$defs/localId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "instructions": { "$ref": "#/$defs/i18n" },
        "passage": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "speakers": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/speaker" } },
        "script": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker", "text"],
            "properties": {
              "speaker": { "type": "string", "pattern": "^[A-Z]$" },
              "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "pattern": "^audio/[a-z0-9._-]+\\.m4a$" }
          }
        },
        "licence": { "$ref": "#/$defs/licence" },
        "author": { "$ref": "#/$defs/person" },
        "sourceUrl": { "type": "string", "format": "uri" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "reading" } } },
          "then": { "required": ["passage"], "not": { "anyOf": [{ "required": ["script"] }, { "required": ["audio"] }, { "required": ["speakers"] }] } },
          "else": { "required": ["speakers", "script", "audio"], "not": { "required": ["passage"] } }
        },
        {
          "if": { "properties": { "licence": { "const": "original" } } },
          "else": { "required": ["sourceUrl"] }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "correct"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "correct": { "type": "boolean" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "type", "prompt", "status", "author"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "section": { "$ref": "#/$defs/localId" },
        "group": { "$ref": "#/$defs/localId" },
        "type": { "type": "string", "enum": ["closed_single", "written"] },
        "answerFormat": { "type": "string", "enum": ["short_text"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/option" },
          "contains": { "properties": { "correct": { "const": true } } },
          "minContains": 1,
          "maxContains": 1
        },
        "explanation": { "$ref": "#/$defs/i18n" },
        "modelAnswer": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mark", "description"],
            "properties": {
              "mark": { "$ref": "#/$defs/mark" },
              "description": { "$ref": "#/$defs/i18n" }
            }
          }
        },
        "sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "status": { "type": "string", "enum": ["draft", "reviewed"] },
        "author": { "$ref": "#/$defs/person" },
        "reviewedBy": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/person" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "closed_single" } } },
          "then": { "required": ["options"], "not": { "anyOf": [{ "required": ["modelAnswer"] }, { "required": ["criteria"] }, { "required": ["answerFormat"] }] } },
          "else": { "required": ["answerFormat", "modelAnswer", "criteria"], "not": { "required": ["options"] } }
        },
        {
          "if": { "properties": { "status": { "const": "reviewed" } } },
          "then": { "required": ["reviewedBy"], "properties": { "reviewedBy": { "$ref": "#/$defs/person" } } }
        }
      ]
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*-[0-9]{3}$" },
    "template": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
    "number": { "type": "integer", "minimum": 1, "maximum": 999 },
    "language": { "type": "string", "enum": ["en"] },
    "status": { "type": "string", "enum": ["draft", "published", "retired"] },
    "author": { "$ref": "#/$defs/person" },
    "publishApprovedBy": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/person" }] },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "published" } } },
      "then": { "required": ["publishApprovedBy"], "properties": { "publishApprovedBy": { "$ref": "#/$defs/person" } } }
    }
  ]
}
